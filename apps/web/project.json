{
  "name": "web",
  "projectType": "application",
  "root": "apps/web",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:web", "type:app", "lang:typescript"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "node",
      "biome",
      "{workspaceRoot}/knip.json",
      "{workspaceRoot}/scripts/**/*.mjs",
      "{workspaceRoot}/.release-please-manifest.json",
      "{workspaceRoot}/release-please-config.json",
      "{workspaceRoot}/gh-secrets.json",
      "{workspaceRoot}/crates/allowlister-remote-protocol/wire/**"
    ]
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx biome check --write apps/web scripts package.json package-lock.json nx.json biome.jsonc .release-please-manifest.json release-please-config.json gh-secrets.json",
        "cwd": "."
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx biome check --formatter-enabled=true --linter-enabled=false apps/web scripts package.json package-lock.json nx.json biome.jsonc .release-please-manifest.json release-please-config.json gh-secrets.json",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx biome lint apps/web scripts && npx knip --production",
        "cwd": "."
      }
    },
    "lint-compiler": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint src app",
        "cwd": "apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p apps/web/tsconfig.json --noEmit",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest --config vitest.config.ts --coverage --run",
        "cwd": "apps/web"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest bench --config vitest.config.ts --run --outputJson ../../target/web-perf/bench.json",
        "cwd": "apps/web"
      },
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/.github/workflows/bench.yml"]
    },
    "render-cost": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/web-render-cost.mjs",
        "cwd": "."
      },
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/.github/workflows/bench.yml"]
    },
    "heap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/web-heap.mjs",
        "cwd": "."
      },
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/.github/workflows/bench.yml"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next build apps/web",
        "cwd": "."
      },
      "cache": false
    },
    "capture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/web/playwright.capture.config.ts",
        "cwd": "."
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next dev apps/web",
        "cwd": "."
      }
    }
  }
}
