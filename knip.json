{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "*.config.ts",
        "eslint.config.mjs",
        "screenshots/**/*.capture.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["next-env.d.ts", ".next/**"],
      "ignoreDependencies": [
        "@playwright/test",
        "@testing-library/user-event",
        "class-variance-authority",
        "clsx",
        "jsdom",
        "tailwind-merge"
      ]
    }
  },
  "ignoreWorkspaces": ["packages/allowlister-remote-plugin"],
  "ignoreBinaries": ["biome", "knip", "tsc", "vitest", "playwright", "next", "eslint"]
}
