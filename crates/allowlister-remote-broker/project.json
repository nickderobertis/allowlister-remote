{
  "name": "allowlister-remote-broker",
  "projectType": "application",
  "root": "crates/allowlister-remote-broker",
  "sourceRoot": "crates/allowlister-remote-broker/src",
  "tags": [
    "scope:broker",
    "type:service",
    "lang:rust"
  ],
  "implicitDependencies": [
    "allowlister-remote-protocol"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "rust"
    ]
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path crates/allowlister-remote-broker/Cargo.toml",
        "cwd": "."
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path crates/allowlister-remote-broker/Cargo.toml --check",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p allowlister-remote-broker --all-targets -- -D warnings",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p allowlister-remote-broker --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo llvm-cov --no-report -p allowlister-remote-broker",
        "cwd": "."
      },
      "dependsOn": [
        {
          "target": "coverage-clean",
          "projects": [
            "workspace"
          ]
        }
      ],
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p allowlister-remote-broker",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/target/debug/allowlister-remote-broker"
      ],
      "cache": false
    },
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo bench --locked -p allowlister-remote-broker --bench protocol",
        "cwd": "."
      },
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/workflows/bench.yml",
        "{workspaceRoot}/scripts/profile.sh"
      ]
    },
    "bench-allocs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo bench --locked --quiet -p allowlister-remote-broker --bench protocol_allocs",
        "cwd": "."
      },
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/workflows/bench.yml",
        "{workspaceRoot}/scripts/profile.sh"
      ]
    }
  }
}
