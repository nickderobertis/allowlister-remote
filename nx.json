{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/tests/**/*"
    ],
    "compilerLint": [
      "{projectRoot}/src/**/*.ts",
      "{projectRoot}/src/**/*.tsx",
      "{projectRoot}/app/**/*.ts",
      "{projectRoot}/app/**/*.tsx",
      "{projectRoot}/eslint.config.mjs",
      "{workspaceRoot}/package-lock.json"
    ],
    "sharedGlobals": ["{workspaceRoot}/nx.json"],
    "node": ["{workspaceRoot}/package.json", "{workspaceRoot}/package-lock.json"],
    "biome": ["{workspaceRoot}/biome.jsonc"],
    "rust": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml"
    ]
  },
  "targetDefaults": {
    "fmt-check": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint-compiler": {
      "cache": true,
      "inputs": ["compilerLint"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "build": {
      "cache": true,
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.next", "{workspaceRoot}/target"]
    },
    "test-e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"]
    },
    "format": {
      "cache": true,
      "inputs": ["default"]
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  }
}
